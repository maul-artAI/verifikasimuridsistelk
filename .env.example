APP_NAME="Verifikasi Siswa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://verifikasi.sekolah.sch.id
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=verifikasi_siswa
DB_USERNAME=isi_user_db_hosting
DB_PASSWORD=isi_password_kuat_disini

# Akun admin TU (dipakai AdminSeeder, minimal 8 karakter)
ADMIN_NAME="Admin TU"
ADMIN_EMAIL=admin@smk.sch.id
ADMIN_PASSWORD=ganti_password_kuat_minimal_8_karakter

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Jam layanan WITA (Senin-Jumat 08:00-14:00, cek data/progres 24 jam)
JAM_KERJA_ENABLED=true
JAM_KERJA_TIMEZONE=Asia/Makassar
JAM_KERJA_BUKA=08:00
JAM_KERJA_TUTUP=14:00

VITE_APP_NAME="${APP_NAME}"
